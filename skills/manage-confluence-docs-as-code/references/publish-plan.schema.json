{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syuantsai.github.io/syp171/publish-plan.schema.json",
  "title": "SYP-171 immutable Markdown publication plan",
  "description": "Version 5 binds a committed Markdown source, validated mapping, remote baselines, payloads, and exact intermediate writes. Versions 1–4 are retired.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "createdAtUtc", "siteOrigin", "cloudId", "publishMode", "docsCommit", "codeCommit", "sourceMode", "sourceDigest", "mappingDigest", "reviewDigest", "validatorVersion", "rendererVersion", "pages", "validationInputs", "linkStrategy"],
  "properties": {
    "schemaVersion": {"const": 5},
    "operationId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "createdAtUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(?:Z|\\+00:00)$"},
    "siteOrigin": {"type": "string", "pattern": "^https://[^/?#]+$"},
    "cloudId": {"type": "string", "pattern": "^[a-fA-F0-9-]{36}$"},
    "publishMode": {"enum": ["current", "draft"]},
    "attachmentStrategy": {"const": "immutable-content-name"},
    "docsCommit": {"$ref": "#/definitions/gitCommit"},
    "codeCommit": {"oneOf": [{"$ref": "#/definitions/gitCommit"}, {"const": ""}]},
    "sourceMode": {"enum": ["git-markdown", "capture-markdown"]},
    "sourceDigest": {"$ref": "#/definitions/sha256"},
    "mappingDigest": {"$ref": "#/definitions/sha256"},
    "reviewDigest": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"const": ""}]},
    "validatorVersion": {"type": "string", "minLength": 1},
    "rendererVersion": {"type": "string", "minLength": 1},
    "linkStrategy": {"const": "identity-first"},
    "pages": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/page"}},
    "validationInputs": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/validationInputs"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"publishMode": {"const": "draft"}}},
      "then": {
        "required": ["attachmentStrategy"],
        "properties": {"pages": {"items": {
          "required": ["expectedDraftVersion", "expectedDraftBodySha256", "draftBaselinePath"],
          "properties": {
            "action": {"enum": ["update", "no-op"]},
            "parentProjectionId": {"const": ""},
            "expectedParentVersion": {"type": "null"},
            "expectedParentBodySha256": {"type": "null"},
            "expectedDraftObservation": {"const": "captured"},
            "deferredTargets": {"maxItems": 0},
            "intermediateWrites": {"items": {"enum": ["no-op", "draft-attachment-upload-or-reuse", "draft-body-update", "draft-and-attachment-readback"]}}
          }
        }}}
      },
      "else": {"not": {"required": ["attachmentStrategy"]}}
    }
  ],
  "definitions": {
    "gitCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\r\\n]+$"},
    "validationInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "mappingPath", "docsCommit"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "mappingPath": {"type": "string", "minLength": 1},
        "docsCommit": {"$ref": "#/definitions/gitCommit"},
        "codeBindingPath": {"type": "string", "minLength": 1},
        "codeReviewPath": {"type": "string", "minLength": 1},
        "reviewPath": {"type": "string", "minLength": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localPath", "displayFilename", "mediaType", "remoteFilename", "sha256", "byteLength", "payloadPath", "action", "remoteAttachmentId", "remoteVersion"],
      "properties": {
        "localPath": {"$ref": "#/definitions/relativePath"},
        "displayFilename": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 1},
        "remoteFilename": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "byteLength": {"type": "integer", "minimum": 0, "maximum": 20971520},
        "payloadPath": {"$ref": "#/definitions/relativePath"},
        "action": {"enum": ["upload", "reuse"]},
        "remoteAttachmentId": {"type": "string", "pattern": "^([0-9]+)?$"},
        "remoteVersion": {"type": "integer", "minimum": 0}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionId", "pageId", "spaceId", "parentId", "parentProjectionId", "title", "action", "expectedPublishedVersion", "expectedPublishedBodySha256", "expectedParentVersion", "expectedParentBodySha256", "expectedDraftObservation", "payloadPath", "payloadSha256", "assetChanges", "intermediateWrites", "deferredTargets"],
      "properties": {
        "projectionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,49}$"},
        "pageId": {"type": "string", "pattern": "^([0-9]+)?$"},
        "spaceId": {"type": "string", "pattern": "^[0-9]+$"},
        "parentId": {"type": "string", "pattern": "^([0-9]+)?$"},
        "parentProjectionId": {"type": "string", "pattern": "^([a-z][a-z0-9-]{0,49})?$"},
        "title": {"type": "string", "minLength": 1},
        "action": {"enum": ["create", "update", "no-op"]},
        "expectedPublishedVersion": {"type": "integer", "minimum": 0},
        "expectedPublishedBodySha256": {"type": "string", "pattern": "^([a-f0-9]{64})?$"},
        "expectedParentVersion": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "expectedParentBodySha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
        "expectedDraftObservation": {"enum": ["same-as-published", "captured"]},
        "payloadPath": {"$ref": "#/definitions/relativePath"},
        "payloadSha256": {"$ref": "#/definitions/sha256"},
        "assetChanges": {"type": "array", "maxItems": 25, "items": {"$ref": "#/definitions/asset"}},
        "intermediateWrites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["create", "update", "no-op", "page-create-intermediate", "page-create-readback", "link-resolution", "attachment-upload", "attachment-upload-or-reuse", "final-page-body-update", "page-body-update", "attachment-and-page-readback", "draft-attachment-upload-or-reuse", "draft-body-update", "draft-and-attachment-readback"]}},
        "deferredTargets": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,49}$"}},
        "expectedDraftVersion": {"type": "integer", "const": 1},
        "expectedDraftBodySha256": {"$ref": "#/definitions/sha256"},
        "draftBaselinePath": {"type": "string", "pattern": "^plan-assets/[a-f0-9]{32}/[a-f0-9]{64}-draft-baseline\\.storage\\.xml$"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "create"}}},
          "then": {"properties": {"pageId": {"const": ""}, "expectedPublishedVersion": {"const": 0}}},
          "else": {"properties": {"pageId": {"pattern": "^[0-9]+$"}, "expectedPublishedVersion": {"minimum": 1}}}
        }
      ]
    }
  }
}
