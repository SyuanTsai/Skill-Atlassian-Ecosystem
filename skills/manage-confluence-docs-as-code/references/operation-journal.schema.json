{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syuantsai.github.io/syp171/operation-journal.schema.json",
  "title": "SYP-171 resumable Confluence operation journal",
  "description": "Per-page write intent and readback progress for one immutable operation. The publisher enforces legal transitions and remote baselines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "planSha256",
    "status",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "planSha256": {
      "$ref": "#/definitions/sha256"
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "uncertain",
        "blocked",
        "confirmed"
      ]
    },
    "pages": {
      "type": "array",
      "maxItems": 100
    },
    "publishMode": {
      "const": "draft"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/pageV1"
            }
          }
        },
        "allOf": [
          {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "publishMode"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/pageV2"
            }
          }
        },
        "allOf": [
          {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "publishMode"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/pageV3"
            }
          }
        },
        "allOf": [
          {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "publishMode"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 4
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "publishMode"
        ],
        "properties": {
          "status": {
            "enum": [
              "planned",
              "in-progress",
              "uncertain",
              "confirmed"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/pageV4"
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 5
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "publishMode"
        ],
        "properties": {
          "status": {
            "enum": [
              "planned",
              "in-progress",
              "uncertain",
              "confirmed"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/pageV5"
            },
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,49}$"
    },
    "pageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "pageId",
        "stage"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/definitions/projectionId"
        },
        "pageId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "stage": {
          "enum": [
            "write-sent",
            "write-response",
            "readback-confirmed"
          ]
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "payloadSha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "stage": {
                "const": "readback-confirmed"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "version",
              "payloadSha256"
            ],
            "properties": {
              "pageId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "journalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteFilename",
        "sha256",
        "stage",
        "remoteAttachmentId",
        "remoteVersion"
      ],
      "properties": {
        "remoteFilename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "stage": {
          "enum": [
            "planned",
            "write-sent",
            "confirmed",
            "readback-confirmed"
          ]
        },
        "remoteAttachmentId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "remoteVersion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pageV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "pageId",
        "stage",
        "assets"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/definitions/projectionId"
        },
        "pageId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "stage": {
          "enum": [
            "planned",
            "page-create-write-sent",
            "page-create-response",
            "intermediate-confirmed",
            "attachment-write-sent",
            "attachment-confirmed",
            "body-write-sent",
            "readback-confirmed"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "payloadSha256": {
          "$ref": "#/definitions/sha256"
        },
        "assets": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/definitions/journalAsset"
          }
        }
      }
    },
    "pageV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "pageId",
        "parentId",
        "stage",
        "resolvedPayloadSha256",
        "version",
        "assets"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/definitions/projectionId"
        },
        "pageId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "parentId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "stage": {
          "enum": [
            "no-op",
            "planned",
            "identity-write-sent",
            "identity-response",
            "identity-confirmed",
            "asset-write-sent",
            "assets-confirmed",
            "final-ready",
            "final-write-sent",
            "final-confirmed"
          ]
        },
        "resolvedPayloadSha256": {
          "type": "string",
          "pattern": "^([a-f0-9]{64})?$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/definitions/journalAsset"
          }
        }
      }
    },
    "pageV4": {
      "additionalProperties": false,
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "confirmed",
                  "no-op"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "readbackBodySha256": {
                "$ref": "#/definitions/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "readbackBodySha256": {
                "const": ""
              }
            }
          }
        }
      ],
      "required": [
        "projectionId",
        "pageId",
        "stage",
        "readbackBodySha256"
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "stage": {
          "enum": [
            "planned",
            "write-sent",
            "confirmed",
            "no-op"
          ]
        },
        "projectionId": {
          "$ref": "#/definitions/projectionId"
        },
        "readbackBodySha256": {
          "type": "string",
          "pattern": "^([a-f0-9]{64})?$"
        }
      }
    },
    "pageV5": {
      "additionalProperties": false,
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "confirmed",
                  "no-op"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "readbackBodySha256": {
                "$ref": "#/definitions/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "readbackBodySha256": {
                "const": ""
              }
            }
          }
        }
      ],
      "required": [
        "projectionId",
        "pageId",
        "stage",
        "readbackBodySha256",
        "assets"
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "stage": {
          "enum": [
            "planned",
            "write-sent",
            "confirmed",
            "no-op"
          ]
        },
        "projectionId": {
          "$ref": "#/definitions/projectionId"
        },
        "readbackBodySha256": {
          "type": "string",
          "pattern": "^([a-f0-9]{64})?$"
        },
        "assets": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/definitions/draftAsset"
          }
        }
      }
    },
    "draftAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteFilename",
        "sha256",
        "stage",
        "remoteAttachmentId",
        "remoteVersion"
      ],
      "properties": {
        "remoteFilename": {
          "type": "string",
          "pattern": "^syp171-[a-z][a-z0-9-]{0,49}-[a-f0-9]{64}\\.(png|jpg|gif|pdf|txt|bin)$"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "stage": {
          "enum": [
            "planned",
            "write-sent",
            "confirmed"
          ]
        },
        "remoteAttachmentId": {
          "type": "string",
          "pattern": "^([0-9]+)?$"
        },
        "remoteVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "remoteAttachmentId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "remoteVersion": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "remoteAttachmentId": {
                "const": ""
              },
              "remoteVersion": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
